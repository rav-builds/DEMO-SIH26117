# ==============================================================================
# Sovereign AI Workbench - Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME="Sovereign AI Workbench"
APP_VERSION="0.1.0"
API_PREFIX="/api"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# ------------------------------------------------------------------------------
# Active Model Serving Backend Toggle
# ------------------------------------------------------------------------------
# Options: 'ollama' | 'mlx' | 'vllm'
# Set this based on the current machine hardware without touching any code:
#   - 'ollama': CPU / Low-VRAM laptop fallback (Quantized GGUF)
#   - 'mlx':    Apple Silicon MacBooks (M1/M2/M3/M4 via LM Studio or mlx-lm)
#   - 'vllm':   Dedicated NVIDIA GPU server (bf16/fp8 high throughput)
MODEL_BACKEND="ollama"

# ------------------------------------------------------------------------------
# Backend Option 1: Ollama / GGUF (Universal CPU / Low-VRAM Fallback)
# ------------------------------------------------------------------------------
# Serving Command:
#   ollama run ornith-1.5:9b-q4_k_m
# To build with mmproj vision projector:
#   ollama create ornith-1.5:9b-q4_k_m -f Modelfile
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_OPENAI_URL="http://localhost:11434/v1"
OLLAMA_MODEL="ornith-1.5:9b-q4_k_m"
OLLAMA_TIMEOUT_SECONDS=120.0

# ------------------------------------------------------------------------------
# Backend Option 2: MLX (Apple Silicon via LM Studio or mlx_lm.server)
# ------------------------------------------------------------------------------
# Serving Commands:
#   Option A (LM Studio): Load "ornith-ai/Ornith-1.5-9B-MLX" and start Local Server on port 1234
#   Option B (mlx-lm CLI): python -m mlx_lm.server --model ornith-ai/Ornith-1.5-9B-MLX --port 8080
MLX_BASE_URL="http://localhost:1234/v1"
MLX_MODEL="ornith-ai/Ornith-1.5-9B-MLX"
MLX_TIMEOUT_SECONDS=120.0

# ------------------------------------------------------------------------------
# Backend Option 3: vLLM (Dedicated GPU Server / Venue Setup)
# ------------------------------------------------------------------------------
# Serving Command:
#   vllm serve "ornith-ai/Ornith-1.5-9B" --port 8000 --enable-auto-tool-choice --tool-call-parser qwen3_xml --reasoning-parser qwen3 --max-model-len 32768
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL="ornith-ai/Ornith-1.5-9B"
VLLM_TIMEOUT_SECONDS=120.0

# ------------------------------------------------------------------------------
# Role Fallbacks & Defaults
# ------------------------------------------------------------------------------
DEFAULT_EMBEDDING_MODEL="nomic-embed-text"

# ------------------------------------------------------------------------------
# Qdrant Vector Store
# ------------------------------------------------------------------------------
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="sovereign_knowledge_base"
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# Vision & OCR Settings
# ------------------------------------------------------------------------------
# Windows path example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / macOS path example: /usr/bin/tesseract
TESSERACT_CMD=""

# ------------------------------------------------------------------------------
# Sandbox & Security
# ------------------------------------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_MEMORY_MB=256
SANDBOX_NETWORK_ACCESS=false
SECRET_KEY="generate-a-secure-secret-key-for-production"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# File-Backed Persistence Paths
# ------------------------------------------------------------------------------
AUDIT_LOG_PATH="data/audit.jsonl"
TASK_STORE_PATH="data/tasks.jsonl"

